@model List<SkillManagement.Models.Skill>

<table class="table">
	<thead>
		<tr>
			<th>Skill</th>
			<th>Description</th>
			<th>User</th>
			<th>Keywords</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var skill in Model) {
			<tr>
				<td>@skill.SkillName</td>
				<td>@skill.Description</td>
				<td>@(skill.User != null ? skill.User.UserName: "")</td>
				<td>
					@{
						List<string> keywords = new List<string>();
						foreach (var keyword in skill.Keywords) {
							keywords.Add(keyword.Key.ToString());
						}
					}
					@String.Join(", ", keywords)
				</td>
			</tr>
		}
	</tbody>
</table>

<a href="@Url.Action("Create", "Skills")">Add a Skill</a>